<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:dist="http://schemas.android.com/apk/distribution">

    <!--
        On-demand delivery: this split is NOT part of the base install. The app
        requests it via SplitInstall when the user sets up find-my-phone
        (IntruderCameraLoader.requestInstall). Until then the device carries
        neither this code nor the CAMERA permission below.
    -->
    <dist:module
        dist:instant="false"
        dist:title="@string/feature_camera_title">
        <dist:delivery>
            <dist:on-demand />
        </dist:delivery>
        <!-- minSdk 26, so no need to fuse into a base multi-APK for pre-Lollipop. -->
        <dist:fusing dist:include="false" />
    </dist:module>

    <!-- Lives here so the base install doesn't declare it. Merged into the app
         only once this module is downloaded. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
</manifest>
