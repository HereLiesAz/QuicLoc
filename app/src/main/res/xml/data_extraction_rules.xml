<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup / device-transfer rules for Android 12+ (API 31+).
    For older versions, backup_rules.xml is used instead.

    Same exclusion list for both cloud-backup (Google Drive) and
    device-transfer (Pixel Switch / Smart Switch / Quick Start). The
    Android Keystore key for EncryptedSharedPreferences only sometimes
    survives device-transfer — we can't rely on it, so the encrypted
    stores stay out of both paths.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="quicloc_secure_prefs.xml" />
        <exclude domain="sharedpref" path="quicloc_secure_prefs_fallback.xml" />
        <exclude domain="sharedpref" path="quicloc_history.xml" />
        <exclude domain="sharedpref" path="quicloc_history_fallback.xml" />
        <exclude domain="sharedpref" path="quicloc_diagnostics.xml" />
        <exclude domain="sharedpref" path="quicloc_diagnostics_fallback.xml" />
        <exclude domain="sharedpref" path="quicloc_tracking_state.xml" />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="quicloc_secure_prefs.xml" />
        <exclude domain="sharedpref" path="quicloc_secure_prefs_fallback.xml" />
        <exclude domain="sharedpref" path="quicloc_history.xml" />
        <exclude domain="sharedpref" path="quicloc_history_fallback.xml" />
        <exclude domain="sharedpref" path="quicloc_diagnostics.xml" />
        <exclude domain="sharedpref" path="quicloc_diagnostics_fallback.xml" />
        <exclude domain="sharedpref" path="quicloc_tracking_state.xml" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
